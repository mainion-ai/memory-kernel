{
  "name": "memory-kernel",
  "version": "1.33.1",
  "description": "Model-agnostic, file-first memory kernel for AI agents",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mk": "dist/cli/mk.js",
    "mk-mcp": "dist/mcp/server.js",
    "memory-kernel": "dist/cli/mk.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "skills/mk-memory-setup/seed-atoms"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "pretest": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "lint:all": "tsc --noEmit -p tsconfig.test.json",
    "mk": "tsx src/cli/mk.ts",
    "mcp": "tsx src/mcp/server.ts",
    "bench": "tsx scripts/bench.ts",
    "bench:baseline": "tsx scripts/bench.ts > scripts/bench-baseline.json"
  },
  "engines": {
    "node": ">=22.16"
  },
  "keywords": [
    "memory",
    "ai",
    "agent",
    "kernel",
    "context"
  ],
  "author": "mainion-ai",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/mainion-ai/memory-kernel.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "better-sqlite3": "^12.6.2",
    "commander": "^15.0.0",
    "js-yaml": "^4.1.1",
    "proper-lockfile": "^4.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@sinclair/typebox": "^0.34.48",
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/proper-lockfile": "^4.1.4",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "qs": "^6.15.2",
    "esbuild": "^0.28.1"
  }
}
